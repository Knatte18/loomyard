def med: map(select(.!=null)) | sort | if length==0 then null else (if length%2==1 then .[length/2|floor] else ((.[length/2-1]+.[length/2])/2) end) end;
def r: if .==null then "-" else (.*100|round/100|tostring) end;
def pct: if .==null then "-" else ((.*100|round|tostring)+"%") end;
def sum: map(select(.!=null)) | add;
# arms: pf = pack file + Start here (after 1e39afc10); raf = pack inline in the prompt with the read-all-first rule
[ .[] | select(.cards>0) ] as $s
| {pf: ($s|map(select(.layout=="file"))), raf: ($s|map(select(.layout=="inline" and .raf)))} as $a
| ([
  ["arm","forks","runs","cards","distinct spans (sum)"],
  ($a|to_entries[]|[.key,(.value|length),(.value|map(.proj)|unique|length),(.value|map(.cards)|sum),(.value|map(.nspans)|sum)]),
  [],
  (["metric (median over forks unless noted)"]+($a|keys)),
  (["forks that opened the pack file (of n)"]+[$a[]|((map(select(.pack_opened))|length|tostring)+" of "+(length|tostring))]),
  (["pack read in assistant turn (median; turn 1 = prompt read)"]+[$a[]|map(.pack_turn)|med|r]),
  (["pack read before first edit"]+[$a[]|((map(select(.pack_before_edit))|length|tostring)+" of "+(length|tostring))]),
  (["pack read opened in a turn with other calls"]+[$a[]|map(select(.par_with_pack>0))|length]),
  (["distinct spans per fork"]+[$a[]|map(.nspans)|med|r]),
  (["distinct spans per card"]+[$a[]|map(.nspans/.cards)|med|r]),
  (["span reached before 1st edit, share (strict, per-fork median)"]+[$a[]|map(select(.nspans>0)|.spans_strict_pre/.nspans)|med|pct]),
  (["span reached before 1st edit, share (strict, pooled)"]+[$a[]|((map(.spans_strict_pre)|sum)/(map(.nspans)|sum))|pct]),
  (["span file touched before 1st edit, share (file-level, per-fork median)"]+[$a[]|map(select(.nspans>0)|.spans_file_pre/.nspans)|med|pct]),
  (["span file touched before 1st edit, share (file-level, pooled)"]+[$a[]|((map(.spans_file_pre)|sum)/(map(.nspans)|sum))|pct]),
  (["spans reached in the first work turn, share (strict, pooled)"]+[$a[]|((map(.spans_strict_first)|sum)/(map(.nspans)|sum))|pct]),
  (["spans reached in the first work turn, share (file-level, pooled)"]+[$a[]|((map(.spans_file_first)|sum)/(map(.nspans)|sum))|pct]),
  (["max spans first reached in one turn (median)"]+[$a[]|map(.spans_strict_max_turn)|med|r]),
  (["forks reaching >=50% of spans (strict) before 1st edit"]+[$a[]|((map(select(.nspans>0 and .spans_strict_pre/.nspans>=0.5))|length|tostring)+" of "+(map(select(.nspans>0))|length|tostring))]),
  (["first work turn: parallel calls (median)"]+[$a[]|map(.first_par)|med|r]),
  (["first work turn: forks with >=3 parallel calls"]+[$a[]|((map(select(.first_par>=3))|length|tostring)+" of "+(length|tostring))]),
  (["first work turn: forks with exactly 1 call"]+[$a[]|((map(select(.first_par==1))|length|tostring)+" of "+(length|tostring))]),
  (["turn of first edit (median)"]+[$a[]|map(.turns_pre)|med|r]),
  (["calls before first edit, raw (median)"]+[$a[]|map(.pre_edit)|med|r]),
  (["calls before first edit, net of pack-file read (median)"]+[$a[]|map(.pre_edit_net)|med|r]),
  (["calls before first edit, net, per card (median)"]+[$a[]|map(select(.pre_edit_net!=null)|.pre_edit_net/.cards)|med|r]),
  (["ex_tools (exploration calls) / card, raw"]+[$a[]|map(.ex_tools/.cards)|med|r]),
  (["ex_net (exploration calls, minus pack-file read) / card"]+[$a[]|map(.ex_net/.cards)|med|r]),
  (["rfull (whole reads) / card"]+[$a[]|map(.rfull/.cards)|med|r]),
  (["rfull_net (minus pack-file read) / card"]+[$a[]|map(.rfull_net/.cards)|med|r]),
  (["rpart (partial reads) / card"]+[$a[]|map(.rpart/.cards)|med|r]),
  (["grep / card"]+[$a[]|map(.grep/.cards)|med|r]),
  (["gmem (member greps) / card"]+[$a[]|map(.gmem/.cards)|med|r]),
  (["quarry lookups / card"]+[$a[]|map(.quarry/.cards)|med|r]),
  (["forks with quarry > 0"]+[$a[]|map(select(.quarry>0))|length]),
  (["tools total / card"]+[$a[]|map(.tools/.cards)|med|r]),
  (["turns / card"]+[$a[]|map(.turns/.cards)|med|r]),
  (["output tokens / card"]+[$a[]|map(.out/.cards)|med|r]),
  (["fresh input tokens / card"]+[$a[]|map(.fresh_in/.cards)|med|r]),
  (["cache read / card"]+[$a[]|map(.cache_read/.cards)|med|r]),
  [],
  (["pooled per card (sum / sum of cards)"]+($a|keys)),
  (["ex_tools","ex_net","rfull","rfull_net","rpart","grep","gmem","quarry","tools","turns","out","fresh_in","cache_read","edits"][] as $k | ["\($k) pooled/card"]+[$a[]|((map(.[$k])|sum)/(map(.cards)|sum))|r]),
  [],
  (["edits (Edit/MultiEdit) total"]+[$a[]|map(.edits)|sum]),
  (["edits to files with no span in the pack"]+[$a[]|(map(.edits_out)|sum) as $o|(map(.edits)|sum) as $e|"\($o) (\($o/$e|pct))"]),
  (["forks with any such edit"]+[$a[]|((map(select(.edits_out>0))|length|tostring)+" of "+(length|tostring))]),
  (["writes total / to files with no span"]+[$a[]|"\(map(.writes)|sum) / \(map(.writes_out)|sum)"]),
  (["pack_res per fork (median)"]+[$a[]|map(.pack_res)|med|r]),
  (["pack_unres per fork (median)"]+[$a[]|map(.pack_unres)|med|r]),
  (["cards per fork (median)"]+[$a[]|map(.cards)|med|r])
 ] | .[] | @tsv)
