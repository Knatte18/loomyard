#!/usr/bin/env bash
# Local launcher for the lyx deploy tool (POSIX twin of deploy.cmd). The install
# dir is the machine's own `go env GOBIN`, else GOPATH/bin — set it per machine with
# `go env -w GOBIN=<dir>`; pass -dest <dir> for a one-off override.
# cd to the repo root (this script's own directory) so `go run` finds go.mod.
cd "$(dirname "$0")"
exec go run ./tools/deploy "$@"
