.vscode/settings.json

# Compiled binary — built with `go build` / `go install`, never committed.
/lyx
lyx.exe

# Same for `go build ./tools/godocreflow/...` run without -o from the repo root.
/godocreflow
godocreflow.exe

# Derived dev-only deploy target (tools/internal/devbin) — never the prod install dir.
.dev-bin/

# Machine-local reed session state (per-cwd), never committed.
.lyx/

# === mill-managed (regenerated by mill-setup) ===
**/.millhouse/
**/.scratch/
**/.wiki
**/.active
**/_mill/*.active
**/.portals
**/.vscode/
# === end mill-managed ===

# prowler plugin: build-on-first-run binary + its build lock — never
# committed (the nested go.mod/go.sum ARE source and stay committed).
plugins/prowler/bin/

# prowler plugin: loose compiled binary left at the module root by a
# plain `go build ./...` run from within plugins/prowler — never committed
# (prowler ships no compiled binary; see plugins/prowler/README.md).
plugins/prowler/prowler
